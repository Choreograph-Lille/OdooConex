<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="account_move_view_form_inherit_export" model="ir.ui.view">
            <field name="name">account.move.view.form.inherit.export</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="choreograph_sage.account_move_view_form_inherit"/>
            <field name="priority" eval="9"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='sage_group']" position="inside">
                    <field name="is_invoice_collected"
                            readonly="1"
                           attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
                    <field name="is_transferred_to_pa"
                            readonly="1"
                           attrs="{'invisible': [('move_type', 'not in', ['out_invoice', 'out_refund'])]}"/>
                </xpath>
            </field>
        </record>

        <!-- Action to export paid invoices -->
        <record id="action_export_paid_invoices" model="ir.actions.server">
            <field name="name">Export Paid Invoices to PA</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.generate_paid_invoices_file()</field>
        </record>
    </data>
</odoo>

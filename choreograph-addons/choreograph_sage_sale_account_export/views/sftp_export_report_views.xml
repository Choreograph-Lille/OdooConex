<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- SFTP Export Report Tree View -->
        <record id="sftp_export_report_tree" model="ir.ui.view">
            <field name="name">sftp.export.report.tree</field>
            <field name="model">sftp.export.report</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="export_date"/>
                    <field name="file_name"/>
                    <field name="line_count"/>
                    <field name="state"/>
                </tree>
            </field>
        </record>

        <!-- SFTP Export Report Form View -->
        <record id="sftp_export_report_form" model="ir.ui.view">
            <field name="name">sftp.export.report.form</field>
            <field name="model">sftp.export.report</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <h1>
                            <field name="file_name"/>
                        </h1>
                        <group>
                            <group>
                                <field name="export_date"/>
                                <field name="type"/>
                                <field name="line_count"/>
                                <field name="state"/>
                            </group>
                            <group>
                                <field name="sftp_server_id"/>
                                <field name="attachment_id"/>
                            </group>
                        </group>
                        <separator string="Message"/>
                        <field name="message"/>
                        <separator string="Export Details"/>
                        <field name="line_ids" readonly="1">
                            <tree>
                                <field name="invoice_ref"/>
                                <field name="amount_total"/>
                                <field name="status"/>
                                <field name="type"/>
                                <field name="message"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Action -->
        <record id="sftp_export_report_action" model="ir.actions.act_window">
            <field name="name">Export Reports</field>
            <field name="res_model">sftp.export.report</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No export report found.
                </p>
            </field>
        </record>
    </data>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Scheduled action to export paid invoices daily -->
		<record id="ir_cron_export_paid_invoices" model="ir.cron">
			<field name="name">Export Paid Invoices to PA ICD</field>
			<field name="model_id" ref="account.model_account_move" />
			<field name="state">code</field>
			<field name="code">model.generate_paid_invoices_file()</field>
			<field name="interval_number">1</field>
			<field name="interval_type">days</field>
			<field name="numbercall">-1</field>
			<field name="active" eval="True" />
		</record>
		<!-- Scheduled action to export UBL invoices weekly -->
		<record id="ir_cron_export_ubl_invoices_to_pa" model="ir.cron">
            <field name="name">PA ICD: Export UBL invoices and credit notes</field>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="numbercall">-1</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="code">model.export_ubl_invoices_to_pa()</field>
            <field name="state">code</field>
        </record>
	</data>
</odoo>
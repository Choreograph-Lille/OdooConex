<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="compute_purchase_retribution" model="ir.cron">
            <field name="name">Compute retribution cost</field>
            <field name="model_id" ref="model_purchase_order"/>
            <field name="state">code</field>
            <field name="active">False</field>
            <field name="code">model.search([('is_retribution_order', '=', False),('state', '=', 'purchase')])._compute_is_retribution_order()</field>
        </record>

        <record id="compute_mymodel_invoice" model="ir.cron">
            <field name="name">Compute Mymodel invoice</field>
            <field name="model_id" ref="model_account_move"/>
            <field name="state">code</field>
            <field name="active">False</field>
            <field name="code">model.update_subscription_invoices()</field>
        </record>

    </data>
</odoo>
<odoo>
    <!-- Form View -->
    <record id="view_order_form_inherit2" model="ir.ui.view">
        <field name="name">sale.order.form.inherit2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="choreograph_sale.view_order_form_inherit" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sms_campaign']" position="before">
                <page name="sale_operation" string="Operation"
                    attrs="{'invisible': ['|', ('recurrence_id', '!=', False), ('project_ids', '=', [])]}">
                    <group>
                        <group>
                            <field name="potential_return" force_save="1" />
                            <field name="potential_return_date"
                                attrs="{'invisible':[('potential_return', '=', False)], 'required': [('potential_return','=',True)]}" />
                            <field name="potential_return_task_id"
                                attrs="{'invisible':[('potential_return', '=', False)]}"
                                readonly="1" force_save="1" />
                            <field name="operation_code" invisible="1" />
                            <field name="return_production_potential"
                                attrs="{'invisible':[('operation_code', 'not in', ['ENR_EMAIL', 'ENR_SMS'])]}" />
                            <field name="return_production_potential_date"
                                attrs="{'invisible':[('return_production_potential', '=', False)]}" />
                            <field name="study_delivery_date"
                                attrs="{'required': [('potential_return','=',True)]}" />
                            <field name="study_delivery_task_id"
                                attrs="{'invisible':[('potential_return', '=', False)]}"
                                readonly="1"
                                force_save="1" />
                            <field name="presentation" force_save="1" />
                            <field name="presentation_date"
                                attrs="{'invisible':[('presentation', '=', False)]}" />
                            <field name="presentation_task_id"
                                attrs="{'invisible':[('presentation', '=', False)]}" readonly="1"
                                force_save="1" />
                            <field name="study_global_task_id" invisible="1" readonly="1"
                                force_save="1" />
                            <field name="presta_delivery_date" invisible="1" />
                        </group>
                        <group>
                            <field name="delivery_info_task_id" />
                            <field name="presta_delivery_info_task_id" />
                            <field
                                name="operation_provider_delivery_ids"
                                attrs="{'invisible':[('operation_provider_delivery_ids', '=', [])]}"
                                options="{'create': False}"
                            >
                                <tree editable="bottom" create="false" delete="false">
                                    <field name="sequence" widget="handle" />
                                    <field name="order_id" invisible="1" />
                                    <field name="delivery_date" />
                                    <field name="task_id" readonly="1" />
                                </tree>
                            </field>
                        </group>
                    </group>
                    <h3>
                        <label for="operation_condition_ids" />
                    </h3>
                    <field name="operation_condition_ids"
                        context="{'default_partner_id': partner_id}" />

                    <label for="methodology_ids" />
                    <field name="methodology_ids" context="{'default_order_id': active_id}" widget="section_and_note_one2many">
                        <tree>
                            <control>
                                <create name="add_section_control"
                                        string="Add a score"
                                        context="{
                                        'default_type': 'score', 'default_display_type': 'line_section',
                                        'form_view_ref': 'choreograph_sale_project.view_methodology_methodology_form',
                                        }"
                                />
                                <create name="add_section_control"
                                        string="Add a selection"
                                        context="{
                                        'default_type': 'selection', 'default_display_type': 'line_section',
                                        'form_view_ref': 'choreograph_sale_project.view_methodology_methodology_form',
                                        }"
                                />
                                <create name="add_line_control"
                                        string="Add a list"
                                        context="{
                                        'no_name': True,
                                        'form_view_ref': 'choreograph_sale_project.view_methodology_methodology_form',
                                        }"
                                />
                            </control>
                            <field name="name" widget="section_and_note_text"/>
                            <field name="methodology_name_id"/>
                            <field name="target_id"/>
                            <field name="target_textarea"/>
                            <field name="target_recence_id"/>
                            <field name="recence_textarea"/>
                            <field name="target_filter_id"/>
                            <field name="filter_textarea"/>
                            <field name="customer_filter_id"/>
                            <field name="customer_filter_textarea"/>
                            <field name="order_id" invisible="True"/>
                            <field name="type" invisible="True"/>
                            <field name="display_type" invisible="True"/>
                        </tree>
                    </field>
                    <field name="is_repartition_mt_1" invisible="1"/>
                    <div attrs="{'invisible': [('is_repartition_mt_1', '=', False)]}">
                        <span>Score/selection repartition</span>
                    </div>
                    <div class="inline" attrs="{'invisible': [('is_repartition_mt_1', '=', False)]}">
                        <label for="is_random"/>
                        <field name="is_random" style="margin-right: 5em;"/>
                        <label for="is_prioritization"/>
                        <field name="is_prioritization"/>
                        <field name="prioritization_textarea"
                               attrs="{'invisible': [('is_prioritization', '=', False)]}"
                               placeholder="Prioritization textarea ..."
                        />
                    </div>
                    <separator/>
                    <span>Base repartition</span>
                    <div class="inline">
                        <label for="is_random_base"/>
                        <field name="is_random_base" style="margin-right: 5em;"/>
                        <label for="is_prioritization_base"/>
                        <field name="is_prioritization_base"/>
                        <field name="prioritization_textarea_base"
                               attrs="{'invisible': [('is_prioritization_base', '=', False)]}"
                               placeholder="Prioritization base textarea ..."
                        />
                    </div>
                    <separator/>
                    <label for="results"/>
                    <field name="results" placeholder="Textarea for results ..."/>
                    <label for="needs_ids" />
                    <field name="needs_ids">
                        <tree editable="bottom">
                            <control>
                                <create name="add_line_control" string="Add a need"/>
                            </control>
                            <field name="needs_id"/>
                            <field name="need_comment" attrs="{'readonly': [('is_display_comment', '=', False)]}"/>
                            <field name="need_type" attrs="{'readonly': [('is_display_comment', '=', True)]}"/>
                            <field name="is_display_comment" invisible="True"/>
                        </tree>
                    </field>
                    <label for="survey_exchange" />
                    <field name="survey_exchange"/>

                    <group>
                        <group>
                            <field name="quantity_to_deliver" />
                        </group>
                        <group>
                            <field name="to_validate" />
                        </group>
                        <field name="segment_ids" force_save="1">
                            <tree editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="segment_number" readonly="1" force_save="1" />
                                <field name="model_selection" />
                                <field name="name" />
                                <field name="ranking" />
                                <field name="quantity" />
                                <field name="depth" />
                                <field name="keycode" />
                                <field name="civility" />
                                <field name="comment" />
                            </tree>
                        </field>
                        <div>
                            <label for="repatriate_information" class="oe_inline" />
                            <field name="repatriate_information" class="oe_inline" />
                        </div>
                    </group>
                    <group>
                        <group>
                            <field name="delivery_provider_delivery_partner_email"/>
                            <field name="delivery_provider_comment"/>
                        </group>
                        <group>
                            <field name="presta_provider_delivery_partner_email"/>
                            <field name="presta_provider_comment"/>
                        </group>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='project_count']" position="after">
                <field name="can_display_redelivery" invisible="1" />
                <field name="can_display_livery_project" invisible="1" />
                <field name="can_display_to_plan" invisible="1" />
                <field name="operation_type_id" invisible="1" />
            </xpath>
            <xpath expr="//button[@id='action_generate_operation']" position="after">
                <button
                    name="action_livery_project"
                    id="livery_project"
                    string="Livery"
                    attrs="{'invisible': [('can_display_livery_project','=',False)]}"
                    class="btn-primary"
                    type="object"
                />
                <button
                    name="action_to_plan"
                    id="to_plan"
                    string="To plan"
                    attrs="{'invisible': [('can_display_to_plan','=',False)]}"
                    class="btn-primary"
                    type="object"
                />
                <button
                    name="action_redelivery"
                    id="redelivery_prod_studies"
                    context="{'redelivery_type': 'studies'}"
                    string="Redelivery studies"
                    attrs="{'invisible': [('can_display_redelivery','=',False)]}"
                    class="btn-secondary"
                    type="object"
                />
                <button
                    name="action_redelivery"
                    id="redelivery_prod_project"
                    context="{'redelivery_type': 'prod'}"
                    attrs="{'invisible': [('can_display_redelivery','=',False)]}"
                    string="Redelivery Prod"
                    class="btn-secondary"
                    type="object"
                />
            </xpath>
        </field>
    </record>

    <record id="view_order_form_inherit_sale_project2" model="ir.ui.view">
        <field name="name">sale.order.form.sale.project2</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_project.view_order_form_inherit_sale_project" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <button name="action_view_project_ids" position="attributes">
                <attribute name="attrs">{'invisible': [('project_ids', '=', [])]}</attribute>
            </button>
        </field>
    </record>

    <record id="view_order_form_inherit_choreograph_sale_inherit" model="ir.ui.view">
        <field name="name">view.order.form.inherit.choreograph.sale.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="choreograph_sale.view_order_form_inherit" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='excluded_provider']" position="before">
                <field name="has_enrichment_email_op" invisible="1" />
            </xpath>
            <xpath expr="//field[@name='excluded_provider']" position="attributes">
                <attribute name="attrs">{'invisible': [('has_enrichment_email_op','=',False)]}</attribute>
            </xpath>
            <xpath expr="//field[@name='optout_link']" position="attributes">
                <attribute name="attrs">{'invisible': [('has_enrichment_email_op','=',False)]}</attribute>
            </xpath>
            <!--<xpath
            expr="//field[@name='routing_base']" position="attributes">
                <attribute name="attrs">{'invisible': [('has_enrichment_email_op','=',False)]}</attribute>
            </xpath>-->
            <xpath expr="//group[@name='bat']/separator[2]" position="attributes">
                <attribute name="attrs">{'invisible': [('has_enrichment_email_op','=',False)]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record model="ir.ui.view" id="view_methodology_target_recence_tree">
    <field name="name">Methodology Score Target Tree</field>
    <field name="model">methodology.target.recence</field>
    <field name="arch" type="xml">
      <tree editable="bottom" create="bottom">
        <field name="name"/>
        <field name="type" optional="hide"/>
        <field name="display_textarea" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="action_methodology_target_recence" model="ir.actions.act_window">
    <field name="name">Recence target</field>
    <field name="res_model">methodology.target.recence</field>
    <field name="view_mode">tree</field>
    <field name="domain">[('type', '=', 'score')]</field>
    <field name="context">{'default_type': 'score'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No recence target found.
      </p>
    </field>
  </record>

  <record id="action_methodology_target_recence_selection" model="ir.actions.act_window">
    <field name="name">Recence selection</field>
    <field name="res_model">methodology.target.recence</field>
    <field name="view_mode">tree</field>
    <field name="domain">[('type', '=', 'selection')]</field>
    <field name="context">{'default_type': 'selection'}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No recence selection found.
      </p>
    </field>
  </record>

  <menuitem id="menu_methodology_target_recence" name="Recence target" parent="menu_methodology" action="action_methodology_target_recence"/>
  <menuitem id="menu_methodology_target_recence_selection" name="Recence selection" parent="menu_methodology" action="action_methodology_target_recence_selection"/>
</odoo>
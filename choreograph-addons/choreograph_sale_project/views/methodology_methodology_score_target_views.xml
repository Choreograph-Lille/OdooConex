<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record model="ir.ui.view" id="view_methodology_score_target_tree">
    <field name="name">Methodology Score Target Tree</field>
    <field name="model">methodology.score.target</field>
    <field name="arch" type="xml">
      <tree editable="bottom" create="bottom">
        <field name="name"/>
        <field name="type" optional="hide"/>
        <field name="display_textarea" optional="show"/>
      </tree>
    </field>
  </record>

  <record id="action_methodology_score_target" model="ir.actions.act_window">
    <field name="name">Target</field>
    <field name="res_model">methodology.score.target</field>
    <field name="view_mode">tree</field>
    <field name="domain">[]</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">
        No target found.
      </p>
    </field>
  </record>

  <menuitem id="menu_methodology_score_target" name="Score" parent="menu_methodology" action="action_methodology_score_target"/>
</odoo>
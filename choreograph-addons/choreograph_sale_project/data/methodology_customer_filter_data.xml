        <record id="customer_channel_email" model="methodology.customer.filter">
            <field name="name">CHANNEL POSTAL+EMAIL (Partial)</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_channel_sms" model="methodology.customer.filter">
            <field name="name">CHANNEL POSTAL+SMS (Partial)</field>
            <field name="display_textarea">False</field>

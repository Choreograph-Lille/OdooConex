        <record id="customer_income_2" model="methodology.customer.filter">
            <field name="name">HIGH-INCOME 2</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_income_3" model="methodology.customer.filter">
            <field name="name">HIGH-INCOME 3</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_income_4" model="methodology.customer.filter">
            <field name="name">HIGH-INCOME 4</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_income_5" model="methodology.customer.filter">
            <field name="name">HIGH-INCOME 5</field>
            <field name="display_textarea">False</field>
        </record>

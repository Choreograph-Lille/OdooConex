<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Customer Filter Records -->
        <record id="customer_dep" model="methodology.customer.filter">
            <field name="name">CUSTOMER FILTER DEPARTMENTS / POSTCODES</field>
            <field name="display_textarea">True</field>
        </record>
        <record id="customer_geoloc" model="methodology.customer.filter">
            <field name="name">GEOLOC CUSTOMER FILTER (CHALANDISE AREA in km)</field>
            <field name="display_textarea">True</field>
        </record>
        <record id="other_filter" model="methodology.customer.filter">
            <field name="name">OTHER CUSTOMER FILTER</field>
            <field name="display_textarea">True</field>
        </record>
        <!-- GENDER -->
        <record id="customer_gender_male" model="methodology.customer.filter">
            <field name="name">MALE GENDER</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_gender_female" model="methodology.customer.filter">
            <field name="name">FEMALE GENDER</field>
            <field name="display_textarea">False</field>
        </record>
        <!-- CSP -->
        <record id="customer_csp_negative" model="methodology.customer.filter">
            <field name="name">CSP-</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_csp_negative_positive" model="methodology.customer.filter">
            <field name="name">CSP-/+</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_csp_positive" model="methodology.customer.filter">
            <field name="name">CSP+</field>
            <field name="display_textarea">False</field>
        </record>

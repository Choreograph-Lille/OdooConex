        <record id="customer_rf_new" model="methodology.customer.filter">
            <field name="name">RF TBC/BC NEW</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_rf_new_tiedes" model="methodology.customer.filter">
            <field name="name">RF TBC/BC NEW TIEDES</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_rf_new_tiedes_abandoners" model="methodology.customer.filter">
            <field name="name">RF TBC/BC NEW TIEDES ABANDONERS</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_rf_unqualified" model="methodology.customer.filter">
            <field name="name">UNQUALIFIED</field>
            <field name="display_textarea">False</field>
        </record>
        <record id="customer_rf_unqualified_gt_24" model="methodology.customer.filter">
            <field name="name">UNQUALIFIED > 24 MONTHS</field>
            <field name="display_textarea">False</field>
        </record>

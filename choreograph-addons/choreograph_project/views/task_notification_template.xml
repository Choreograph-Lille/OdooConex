<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="task_notification_template" model="mail.template">
            <field name="name">Task notification</field>
            <field name="model_id" ref="project.model_project_task"/>
            <field name="subject">New task created</field>
            <field name="partner_to">{{ ctx["partner_to"]}}</field>
            <field name="lang">{{ ctx["lang"]}}</field>
            <field name="body_html" type="html">
               <div>
                    Hi<br/><br/>
                    You have been assigned a new task entitled <t t-out="ctx.get('task_name')"></t>.
                    <div style="text-align: center; padding: 16px 0px 16px 0px;">
                        <a style="background-color: #875A7B; padding: 8px 16px 8px 16px; text-decoration: none; color: #fff; border-radius: 5px; font-size:13px;" t-att-href="ctx.get('task_url')" target="_blank">View task</a><br/>
                    </div>
               </div>
           </field>
        </record>
    
    </data>
    

</odoo>

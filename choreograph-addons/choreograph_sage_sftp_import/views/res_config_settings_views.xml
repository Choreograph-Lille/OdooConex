<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.choreograph.sage.sftp.import</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='quick_edit_mode']" position="after">

                    <h2>SAGE to Odoo</h2>
                    <div class="row mt16 o_settings_container" id="sage_to_odoo">
                        <div class="col-12 o_setting_box">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">SFTP Server</span>
                                <div class="text-muted">
                                    Shared SFTP server used for both sales and purchases imports.
                                </div>
                                <div class="content-group mt8">
                                    <field name="sftp_import_server_id"
                                           options="{'no_create': True}"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row mt16 o_settings_container" id="sage_sale_purchase_config"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sftp_logging_view_tree" model="ir.ui.view">
        <field name="name">sftp.logging.view.tree</field>
        <field name="model">sftp.logging</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false"
                decoration-success="state == 'success'"
                decoration-warning="state == 'partial'"
                decoration-danger="state == 'failed'">
                <field name="import_date"/>
                <field name="type"/>
                <field name="file_name"/>
                <field name="line_count"/>
                <field name="success_count"/>
                <field name="error_count"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record id="sftp_logging_view_form" model="ir.ui.view">
        <field name="name">sftp.logging.view.form</field>
        <field name="model">sftp.logging</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="import_date"/>
                            <field name="state"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="file_name"/>
                            <field name="attachment_id"/>
                            <field name="sftp_server_id"/>
                        </group>
                    </group>
                    <group string="Résultat">
                        <group>
                            <field name="line_count"/>
                            <field name="success_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <group>
                        <field name="message"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sftp_logging_action" model="ir.actions.act_window">
        <field name="name">SFTP Import Logs</field>
        <field name="res_model">sftp.logging</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No import logs yet. When you import files from Sage via SFTP, the logs will appear here.
            </p>
        </field>
    </record>

</odoo>
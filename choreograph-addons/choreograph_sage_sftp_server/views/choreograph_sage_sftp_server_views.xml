<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="choreograph_sage_sftp_server_view_tree" model="ir.ui.view">
            <field name="name">choreograph.sage.sftp.server.view.tree</field>
            <field name="model">choreograph.sage.sftp.server</field>
            <field name="arch" type="xml">
                <tree decoration-muted="(not active)">
                    <field name="host"/>
                    <field name="port"/>
                    <field name="username"/>
                    <field name="output_path"/>
                    <field name="active" widget="boolean_toggle"/>
                </tree>
            </field>
        </record>

        <record id="choreograph_sage_sftp_server_view_form" model="ir.ui.view">
            <field name="name">choreograph.sage.sftp.server.view.form</field>
            <field name="model">choreograph.sage.sftp.server</field>
            <field name="arch" type="xml">
                <form string="">
                    <header>
                        <button string="Test connection" name="action_connection_test" type="object" class="oe_highlight"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="host"/>
                                <field name="port"/>
                                <field name="output_path"/>
                                <field name="passphrase" password="True"/>
                            </group>
                            <group>
                                <field name="key_attachment_id"/>
                                <field name="username"/>
                                <field name="active" widget="boolean_toggle"/>
                                <field name="connection_status"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="choreograph_sage_sftp_server_action" model="ir.actions.act_window">
            <field name="name">SAGE SFTP Servers</field>
            <field name="res_model">choreograph.sage.sftp.server</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'active_test': False}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add a new server
                </p>
            </field>
        </record>

</odoo>

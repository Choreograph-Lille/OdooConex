<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tree view -->
    <record id="sftp_import_report_view_tree" model="ir.ui.view">
        <field name="name">sftp.import.report.view.tree</field>
        <field name="model">sftp.import.report</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false"
                decoration-success="state == 'success'"
                decoration-warning="state == 'partial'"
                decoration-danger="state == 'failed' or state == 'rejected'">
                <field name="import_date"/>
                <field name="file_name"/>
                <field name="line_count"/>
                <field name="success_count"/>
                <field name="error_count"/>
                <field name="duration"/>
                <field name="state"/>
                <field name="type" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Form view -->
    <record id="sftp_import_report_view_form" model="ir.ui.view">
        <field name="name">sftp.import.report.view.form</field>
        <field name="model">sftp.import.report</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group string="General">
                            <field name="import_date"/>
                            <field name="duration"/>
                            <field name="state"/>
                            <field name="type"/>
                        </group>
                        <group string="File">
                            <field name="file_name"/>
                            <field name="attachment_id"/>
                            <field name="sftp_server_id"/>
                        </group>
                    </group>
                    <group string="Results">
                        <group>
                            <field name="line_count"/>
                            <field name="success_count"/>
                            <field name="error_count"/>
                        </group>
                    </group>
                    <group string="Message">
                        <field name="message" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Error details">
                            <field name="error_line_ids" readonly="1">
                                <tree>
                                    <field name="invoice_ref"/>
                                    <field name="error_type"/>
                                    <field name="message"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="sftp_import_report_action_sale" model="ir.actions.act_window">
        <field name="name">Sales Import Logs</field>
        <field name="res_model">sftp.import.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('type', '=', 'sale')]</field>
        <field name="context">{'default_type': 'sale'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No import log yet
            </p>
        </field>
    </record>

    <record id="sftp_import_report_action_purchase" model="ir.actions.act_window">
        <field name="name">Purchases Import Logs</field>
        <field name="res_model">sftp.import.report</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('type', '=', 'purchase')]</field>
        <field name="context">{'default_type': 'purchase'}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No import log yet
            </p>
        </field>
    </record>    
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.choreograph.sage.sale.account</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@id='quick_edit_mode']" position="after">
                    <h2>Sage Sale Account</h2>
                    <div class="row mt16 o_settings_container" id="sage_sale">
                        <div class="col-12 col-lg-6 o_setting_box"
                             id="sage_sale_files_informations"
                             title="Allow you to input Sage sale file values">
                            <div class="o_setting_left_pane"/>
                            <div class="o_setting_right_pane">
                                <div class="text-muted">
                                    Define prefix and suffix for Sage sale invoice files (PAYVEN).
                                </div>
                                <div class="content-group">
                                    <div class="row mt16">
                                        <label for="sage_sale_file_prefix"
                                               class="col-lg-3 o_light_label"/>
                                        <field name="sage_sale_file_prefix"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="sage_sale_file_suffix"
                                               class="col-lg-3 o_light_label"/>
                                        <field name="sage_sale_file_suffix"/>
                                    </div>
                                    <div class="row mt16">
                                        <label for="sage_sale_file_date"
                                            class="col-lg-3 o_light_label"/>
                                        <field name="sage_sale_file_date"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="account_move_view_form_inherit" model="ir.ui.view">
            <field name="name">account.move.view.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="priority" eval="100"/>
            <field name="arch" type="xml">
                <group name="accounting_info_group" position="inside">
                    <field name="is_confidential"/>
                    <field name="siren"/>
                </group>
                <field name="invoice_vendor_bill_id" position="after">
                    <field name="sale_order_id" invisible="1"/>
                </field>
                <xpath expr="//field[@name='team_id']" position="attributes">
                    <attribute name="attrs"></attribute>
                </xpath>
                <field name="partner_bank_id" position="after">
                    <field name="provider_invoice_date" 
                        attrs="{
                            'invisible': [('move_type', 'not in', ['in_invoice', 'in_refund', 'in_receipt'])],
                            'readonly': [('state', '!=', 'draft')],
                        }"
                    />
                </field>
            </field>
        </record>
    
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record id="view_company_form_inherit" model="ir.ui.view">
            <field name="name">res.company.view.form.inherit</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <field name="favicon" position="after">
                    <field name="new_address" widget="html"/>
                </field>
            </field>
        </record>

        <record id="res_company_form_l10n_fr_inherited" model="ir.ui.view">
            <field name="name">res.company.form.inherited</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="l10n_fr.res_company_form_l10n_fr"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='siret']" position="after">
                    <field name="siren"/>
                    <field name="electronic_address"/>
                </xpath>
            </field>
        </record>
    
    </data>
    

</odoo>

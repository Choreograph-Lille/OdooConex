<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <record id="res_partner_form_view_inherit" model="ir.ui.view">
            <field name="name">res.partner.form.view.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="l10n_fr.res_partner_form_l10n_fr"/>
            <field name="arch" type="xml">
                <group name="misc" position="inside">
                    <field name="siret" position="move"/>
                    <field name="siren"/>
                    <field name="electronic_address" attrs="{'invisible': [('is_company', '=', False)]}"/>
                </group>
            </field>
        </record>

        <record id="res_partner_form_view_confidential" model="ir.ui.view">
            <field name="name">res.partner.form.view.inherit.confidential</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <field name="category_id" position="after">
                    <field name="is_confidential" />
                </field>
                <xpath expr="//field[@name='property_account_position_id']" position="after">
                    <field name="pf_code_identification" attrs="{'invisible': [('is_company', '=', False)]}"/>
                    <field name="vatex" attrs="{'invisible': [('is_company', '=', False)]}"/>
                </xpath>
            </field>
        </record>
        
        <record id="account.res_partner_action_customer" model="ir.actions.act_window">
            <field name="view_ids"
                   eval="[(5,0,0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('base.view_partner_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        </record>
        
        <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
            <field name="view_ids"
                   eval="[(5,0,0),
                          (0, 0, {'view_mode': 'kanban', 'view_id': ref('base.res_partner_kanban_view')}),
                          (0, 0, {'view_mode': 'tree', 'view_id': ref('base.view_partner_tree')}),
                          (0, 0, {'view_mode': 'form', 'view_id': ref('base.view_partner_form')})]"/>
        </record>

        <record id="customer_statements_form_view_inherit" model="ir.ui.view">
            <field name="name">customer.statements.followup.inherit</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account_followup.customer_statements_form_view"/>
            <field name="arch" type="xml">
                <field name="total_due" position="before">
                    <field name="pricelist_currency_id" invisible="1"/>
                </field>
                <field name="total_due" position="attributes">
                    <attribute name="options">{'currency_field': 'pricelist_currency_id'}</attribute>
                </field>
                <field name="total_overdue" position="attributes">
                    <attribute name="options">{'currency_field': 'pricelist_currency_id'}</attribute>
                </field>
            </field>
        </record>

        <record id="res_partner_form_view_notes_pa" model="ir.ui.view">
            <field name="name">res.partner.form.view.inherit.notes.pa</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='internal_notes']" position="after">
                    <page name="notes_pa" string="Notes PA">
                        <group>
                           <group>
                                <field name="notes_pa" widget="text"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    
    </data>
</odoo>